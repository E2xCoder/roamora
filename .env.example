# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- DATABASE
# SQLite file. Relative paths resolve against the repository root.
DATABASE_URL="file:./prisma/dev.db"

# -------------------------------------------------------------------- AUTH
# Generate both with:  npm run auth:hash -- "your password"
#
# Leaving these empty runs the instance UNPROTECTED (useful for a first local
# run). Set them before exposing the server to a network.
#
# Note: values here must not contain '$' — Next.js expands $NAME in .env files
# as a reference to another variable. The generated hash uses dots for exactly
# this reason.
AUTH_SECRET=
ROAMORA_PASSWORD_HASH=

# ---------------------------------------------------------------------- AI
# "ollama" for a local model, "none" to disable AI features (they then show an
# explicit "not configured" state rather than degrading silently).
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --------------------------------------------------------------- MAP TILES
MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
MAP_TILE_ATTRIBUTION=

# ---------------------------------------------------------------- GEOCODING
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires a real identifying User-Agent.
NOMINATIM_USER_AGENT=Roamora/1.0

# ------------------------------------------------------------------ ROUTING
ROUTING_PROVIDER=osrm
OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
OSRM_BIKE_URL=https://routing.openstreetmap.de/routed-bike
OSRM_CAR_URL=https://routing.openstreetmap.de/routed-car

# ------------------------------------------------- OPEN DATA / TRAIL SOURCES
OVERPASS_URL=https://overpass-api.de/api/interpreter
WIKIVOYAGE_URL=https://en.wikivoyage.org/w/api.php
WAYMARKED_URL=https://hiking.waymarkedtrails.org/api/v1

# ------------------------------------------------------------------ STORAGE
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# -------------------------------------------------------- SOURCE INGESTION
# Optional. If yt-dlp is not installed the import UI reports it as a named
# capability gap; it never reports an empty extraction as success.
YTDLP_PATH=yt-dlp

# --------------------------------------------------------- WEB RESEARCH
# Optional. Powers autonomous opening-hours/price/event enrichment beyond what
# OSM tags carry (needs AI_PROVIDER=ollama too — extraction requires both a
# search backend and an LLM). Self-hostable, keyless — no paid search API
# required, but SearXNG's JSON API is OFF by default and must be enabled:
#   docker run -d -p 8081:8080 searxng/searxng
#   docker exec -it <container> sh -c "echo 'search:\n  formats: [html, json]' >> /etc/searxng/settings.yml"
#   (then restart the container so it re-reads settings.yml)
# Public keyless instances are not a reliable substitute: as of this writing
# every instance listed on searx.space either rate-limits (429) or serves an
# Anubis bot-check page instead of JSON, even on a 200 response.
# Leaving this empty is fully supported: autoplan runs on OSM data alone with
# a lower-confidence result rather than failing.
SEARXNG_URL=

# ------------------------------------------------------------ TRANSIT ROUTING
# Optional. OpenTripPlanner is a separate, self-hosted service fed a
# destination's OSM extract + GTFS feed — real infrastructure to run, not a
# setting this app can turn on by itself. Requires Java 25+ (OTP 2.9's shaded
# jar is compiled to class-file version 69; Java 21 fails to even start it
# with UnsupportedClassVersionError). Its routable API is GraphQL at
# POST {OTP_URL}/otp/gtfs/v1 (OTP1's REST /plan endpoint no longer exists in
# OTP 2.x). Rough shape:
#   java -Xmx4G -jar otp-shaded-2.9.0.jar --build --save ./graph_dir   (osm .pbf + gtfs .zip in graph_dir)
#   java -Xmx4G -jar otp-shaded-2.9.0.jar --load ./graph_dir
# Leaving this empty means itineraries use walking only; transit legs are
# never estimated without it.
OTP_URL=

# --------------------------------------------------- AUTONOMOUS DISCOVERY
# Radius (metres) searched around a destination when building an itinerary
# automatically. Larger radii cost more time/load against the Overpass
# instance above.
DISCOVERY_RADIUS_METERS=1500

# --------------------------------------------------------- DEFERRED (phase 8)
# Leave empty until implemented. Empty = feature shows an explicit
# "not configured" empty state.
FLIGHT_PROVIDER=
